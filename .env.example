# 服务器侧 .env 模板，不要提交到仓库
# 用法：cp .env.example .env，然后填实际值

# === Caddy Basic Auth 凭据 ===
# 生成密码 hash：
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "你的密码"
# ⚠️ 写入 .env 时整段必须用单引号包，否则 bash 会吞掉 $ 符号

BASIC_AUTH_USER=family
BASIC_AUTH_HASH=$2a$14$replace_me_with_real_bcrypt_hash

# === Caddy 监听的宿主机端口 ===
# 默认 80。如果服务器 80 被占用（如已有 nginx），改成其他空闲端口，
# 比如 18080，然后通过 http://<IP>:18080/ 访问
# CADDY_HOST_PORT=80
