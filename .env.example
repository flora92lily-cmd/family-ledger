# 服务器侧 .env 模板，不要提交到仓库
# 推荐用脚本一键设置，避免手动转义出错：
#   bash scripts/set-password.sh
#
# 如果一定要手动写 .env，注意 docker compose env_file 会对 $ 做插值，
# bcrypt hash 里的每个 $ 必须双写成 $$ 才能正确传给容器：
#   原始 hash: $2a$14$abcdefg...
#   写入 .env: $$2a$$14$$abcdefg...

BASIC_AUTH_USER=family
BASIC_AUTH_HASH=$$2a$$14$$replace_with_escaped_hash
CADDY_HOST_PORT=18080
